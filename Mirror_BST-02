#include <iostream>
#include <queue>
#include <algorithm>
using namespace std;

struct Node {
    int data;
    Node* left;
    Node* right;

    Node(int value) {
        data = value;
        left = right = NULL;
    }
};

Node* insert(Node* root, int data) {
    if (root == NULL)
        return new Node(data);

    if (data < root->data)
        root->left = insert(root->left, data);
    else if (data > root->data)
        root->right = insert(root->right, data);

    return root;
}

void LevelOrder(Node* root) {
    if (root == NULL)
        return;

    queue<Node*> q;
    q.push(root);

    while (!q.empty()) {
        int levelSize = q.size();

        while (levelSize > 0) {
            Node* curr = q.front();
            q.pop();

            cout << curr->data << " ";

            if (curr->left != NULL)
                q.push(curr->left);

            if (curr->right != NULL)
                q.push(curr->right);

            levelSize--;
        }
        cout << "| ";
    }
    cout << endl;
}

int Height(Node* root) {
    if (root == NULL)
        return -1;

    int leftHeight = Height(root->left);
    int rightHeight = Height(root->right);

    return max(leftHeight, rightHeight) + 1;
}

void DisplayLeafNodes(Node* root) {
    if (root == NULL)
        return;

    if (root->left == NULL && root->right == NULL) {
        cout << root->data << " ";
        return;
    }

    DisplayLeafNodes(root->left);
    DisplayLeafNodes(root->right);
}

void Mirror(Node* root) {
    if (root == NULL)
        return;

    swap(root->left, root->right);

    Mirror(root->left);
    Mirror(root->right);
}

int main() {
    Node* root = NULL;
    int N, value;

    cout << "Enter the Number of Nodes: ";
    cin >> N;

    cout << "Enter the Node Data of " << N << " values: ";

    for (int i = 0; i < N; i++) {
        cin >> value;
        root = insert(root, value);
    }

    cout << "\n--- Binary Search Tree Details ---\n";

    cout << "Level-wise Traversal: ";
    LevelOrder(root);

    cout << "Height of the Tree: " << Height(root) << endl;

    cout << "Leaf Nodes: ";
    DisplayLeafNodes(root);
    cout << endl;

    cout << "\nMirroring the tree...\n";
    Mirror(root);

    cout << "Level-wise Traversal of Mirror Tree: ";
    LevelOrder(root);

    cout << "Height of Mirror Tree: " << Height(root) << endl;

    cout << "Leaf Nodes of Mirror Tree: ";
    DisplayLeafNodes(root);
    cout << endl;

    return 0;
}
